<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="start"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/ic_focus" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginTop="16dp"
            android:text="@string/register_title" />

        <TextView
            style="@style/ScreenSubtitle"
            android:text="@string/register_subtitle" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="20dp"
            android:labelFor="@id/registerUsernameInput"
            android:text="@string/username" />

        <EditText
            android:id="@+id/registerUsernameInput"
            style="@style/FormInput"
            android:hint="@string/username_hint"
            android:imeOptions="actionNext"
            android:inputType="text|textNoSuggestions"
            android:textDirection="firstStrong" />

        <TextView
            style="@style/FieldLabel"
            android:labelFor="@id/registerPasswordInput"
            android:text="@string/password" />

        <EditText
            android:id="@+id/registerPasswordInput"
            style="@style/FormInput"
            android:hint="@string/new_password_hint"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:saveEnabled="false" />

        <TextView
            style="@style/FieldLabel"
            android:labelFor="@id/confirmPasswordInput"
            android:text="@string/confirm_password" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            style="@style/FormInput"
            android:hint="@string/confirm_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/registerButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="@string/register_button" />

        <TextView
            android:id="@+id/loginLink"
            style="@style/FormLink"
            android:text="@string/login_link" />

    </LinearLayout>

</ScrollView>
